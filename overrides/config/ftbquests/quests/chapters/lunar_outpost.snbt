          "item": "deepfield:ore_processor"
        }
      ]
    },
    {
      "id": "4A60000000000105",
      "x": 4.8,
      "y": -2.0,
      "title": "Питание на Луне",
      "dependencies": [
        "4A60000000000102"
      ],
      "description": [
        "Подключи солнечную панель к накопителю на Луне. Проверь, что под освещённым открытым небом заряд растёт.",
        "Подключи потребителя и проверь, что он получает FE. Убедись, что у жилого модуля есть запас воздуха на время пробного пуска оборудования."
      ],
      "tasks": [
        {
          "id": "4A60000000050000",
          "type": "dimension",
          "dimension": "deepfield:moon"
